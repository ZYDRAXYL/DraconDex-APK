# sqflite_common_ffi_web assets (see lib/core/database/db_factory_web.dart).
# Generated by `dart run sqflite_common_ffi_web:setup`, run in CI
# (.github/workflows/build-web.yml) — the exact sqlite3.wasm/sqflite_sw.js
# build is resolved against pubspec.lock's sqlite3 version, so it cannot be
# hand-authored or safely fabricated outside a real Dart toolchain run.
/web/sqlite3.wasm
/web/sqflite_sw.js
